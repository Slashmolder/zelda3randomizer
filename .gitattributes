* text=auto eol=lf

# Windows project and command files are commonly rewritten by Windows tools.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.rc text eol=crlf

# Source and tooling should stay LF across platforms.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.s text eol=lf
*.py text eol=lf
*.pl text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
Makefile text eol=lf

# Binary assets and data.
*.bin binary
*.dat binary
*.ico binary
*.jpg binary
*.png binary
*.sav binary
*.sfc binary
*.zip binary
