# Generated chest-table artifact (extract_resources.dump_chest_table);
# consumed by the rando chest_lookup codegen. See assets/chest_data.py.
/assets/rando/chest_table.gen.bin
# Pot ground-truth dump (zelda3 --dump-pot-table); generated from ROM assets and
# consumed by gen_pot_tables.py. Keep it local/untracked.
/assets/rando/pot_dump.gen.txt
# Terrain ground-truth dump (zelda3 --dump-terrain-table); generated from ROM
# assets and consumed by gen_terrain_tables.py (add-rando-grass-rock-shuffle).
/assets/rando/terrain_dump.gen.txt
# Generated terrain registry (gen_terrain_tables.py --emit); consumed by rando
# codegen when present, like pots.gen.yaml. Mirrored by setup_worktree.py.
/assets/rando/terrain.gen.yaml
# Generated pot registries. They are derived from local ROM/extracted assets and
# are consumed by rando codegen when present; public CI builds without them.
/assets/rando/pots.gen.yaml
/assets/rando/pot_key_depth.gen.yaml
/assets/rando/enemy_drops.gen.yaml
/assets/rando/enemy_checks.gen.yaml
/assets/rando/enemy_check_candidates.audit.yaml
# add-enemy-souls: kill-gated-room soul requirements (from zelda3_assets.dat +
# the committed door tables); absent => souls_shuffle=all fails closed.
/assets/rando/soul_rooms.gen.yaml
# add-rando-bonk-sanity: OW bonk-item registry (gen_bonk_tables.py, from ROM
# sprite tables); absent => bonk_shuffle fails closed. Mirrored by setup_worktree.py.
/assets/rando/bonk.gen.yaml
/key_depth.txt
/zelda3.sfc
/zelda3.smc
/saves/*.sav
/saves/sram.dat
/saves/sram.bak
/saves/sram_rando.dat
/saves/rando_window.ini
