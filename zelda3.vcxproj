  <!-- Rando codegen pre-build event (tasks.md §3.5/§3.6/§6.3/§9.4b;
       direct_grant_icons.h is Phase B Slice 9 — add-rando-confirmation-icons).
       Regenerates src\rando\logic_data.c, src\rando\location_ids.h,
       src\rando\item_ids.h, src\rando\chest_lookup.h, src\rando\pot_lookup.h,
       src\rando\enemy_drop_lookup.h,
       src\rando\enemy_check_lookup.h,
       src\rando\pot_nonpot_drop_counts.h, src\rando\icon_atlas.h,
       src\rando\direct_grant_icons.h from assets\rando\*.yaml +
       assets\chest_data.py (ALTTPR chest-name catalog; the vanilla chest table
       itself is read from the gitignored assets\rando\chest_table.gen.bin) +
       the committed door-shuffle manifest assets\rando\door_predicates.gen.json
       (emitted by gen_door_tables.py from a reference checkout, NOT by this
       build) and its companion assets\rando\door_portals.yaml. Optional local
       registries are gitignored ROM-derived artifacts and are consumed when
       present. -->
  <!-- RandoCodegenInput = EXACTLY the files rando_logic_gen.py reads or
       existence-checks during its normal invocation — no more, no less.
       Optional local registries (assets\rando\chest_table.gen.bin,
       assets\rando\pots.gen.yaml / pot_key_depth.gen.yaml /
       enemy_drops.gen.yaml / enemy_checks.gen.yaml / soul_rooms.gen.yaml
       (gitignored local registries, conditionally included only when present).
       logic.schema.yaml and zelda3_assets.dat are presence-only probes: adding or
       deleting either invalidates the state file, but touching their contents does not.
       Too few → an incremental build skips codegen on a stale-output check and ships a
       stale logic_data.c. Too many (e.g. @(None), which pulls in tables\zelda3_assets.dat
       + saves\ref\*.sav that codegen never reads) → spurious rebuilds, or always-run when
       a listed input is absent in a fresh worktree.
       NOTE: this MUST be an <ItemGroup>, not a literal glob in the Target's Inputs="...".
       A Target's Inputs attribute does NOT expand recursive ** — MSBuild treats
       "logic_parts\**\*.yaml" as a single nonexistent file and rebuilds every time.
       An ItemGroup Include DOES expand **, so @(RandoCodegenInput) is the real file set
       and the up-to-date check works (skips when unchanged, fires on any logic_parts edit). -->
  <ItemGroup>
    <RandoCodegenInput Include="assets\rando\op_registry.yaml" />
    <RandoCodegenInput Include="assets\rando\item_registry.yaml" />
    <RandoCodegenInput Include="assets\rando\location_registry.yaml" />
    <RandoCodegenInput Include="assets\rando\icon_atlas.yaml" />
    <RandoCodegenInput Include="assets\rando\direct_grant_icons.yaml" />
    <RandoCodegenInput Include="assets\rando\logic.yaml" />
    <RandoCodegenInput Include="assets\rando\macros.yaml" />
    <RandoCodegenInput Include="assets\rando\npc_souls.yaml" />
    <RandoCodegenInput Include="assets\rando\entrance_registry.yaml" />
    <RandoCodegenInput Include="assets\rando\door_predicates.gen.json" />
    <RandoCodegenInput Include="assets\rando\door_portals.yaml" />
    <RandoCodegenOptionalInput Include="assets\rando\chest_table.gen.bin" Condition="Exists('assets\rando\chest_table.gen.bin')" />
    <RandoCodegenOptionalInput Include="assets\rando\pots.gen.yaml" Condition="Exists('assets\rando\pots.gen.yaml')" />
    <RandoCodegenOptionalInput Include="assets\rando\pot_key_depth.gen.yaml" Condition="Exists('assets\rando\pot_key_depth.gen.yaml')" />
    <RandoCodegenOptionalInput Include="assets\rando\terrain.gen.yaml" Condition="Exists('assets\rando\terrain.gen.yaml')" />
    <RandoCodegenOptionalInput Include="assets\rando\bonk.gen.yaml" Condition="Exists('assets\rando\bonk.gen.yaml')" />
    <RandoCodegenOptionalInput Include="assets\rando\enemy_drops.gen.yaml" Condition="Exists('assets\rando\enemy_drops.gen.yaml')" />
    <RandoCodegenOptionalInput Include="assets\rando\enemy_checks.gen.yaml" Condition="Exists('assets\rando\enemy_checks.gen.yaml')" />
    <RandoCodegenOptionalInput Include="assets\rando\soul_rooms.gen.yaml" Condition="Exists('assets\rando\soul_rooms.gen.yaml')" />
    <RandoCodegenPresenceInput Include="assets\rando\logic.schema.yaml" Condition="Exists('assets\rando\logic.schema.yaml')" />
    <RandoCodegenPresenceInput Include="zelda3_assets.dat" Condition="Exists('zelda3_assets.dat')" />
    <RandoCodegenInput Include="@(RandoCodegenOptionalInput)" />
    <RandoCodegenInput Include="assets\rando\logic_parts\**\*.yaml" />
    <RandoCodegenInput Include="assets\rando_logic_gen.py" />
    <RandoCodegenInput Include="assets\chest_data.py" />
    <RandoCodegenOutput Include="src\rando\logic_data.c" />
    <RandoCodegenOutput Include="src\rando\location_ids.h" />
    <RandoCodegenOutput Include="src\rando\item_ids.h" />
    <RandoCodegenOutput Include="src\rando\chest_lookup.h" />
    <RandoCodegenOutput Include="src\rando\pot_lookup.h" />
    <RandoCodegenOutput Include="src\rando\terrain_lookup.h" />
    <RandoCodegenOutput Include="src\rando\bonk_lookup.h" />
    <RandoCodegenOutput Include="src\rando\enemy_drop_lookup.h" />
    <RandoCodegenOutput Include="src\rando\enemy_check_lookup.h" />
    <RandoCodegenOutput Include="src\rando\pot_nonpot_drop_counts.h" />
    <RandoCodegenOutput Include="src\rando\icon_atlas.h" />
    <RandoCodegenOutput Include="src\rando\direct_grant_icons.h" />
  </ItemGroup>
  <!-- Record which optional content inputs and presence-only probes exist.
       WriteOnlyWhenDifferent preserves the timestamp on ordinary builds, while
       adding or deleting any listed file invalidates the stamp. Missing outputs
       also invalidate it. -->
  <Target Name="RandoCodegenState">
    <WriteLinesToFile File="$(IntDir)rando_codegen_inputs.txt"
                      Lines="version=3;@(RandoCodegenOptionalInput);@(RandoCodegenPresenceInput)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_MissingRandoCodegenOutput Include="@(RandoCodegenOutput)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(IntDir)rando_codegen.stamp" Condition="'@(_MissingRandoCodegenOutput)' != ''" />
  </Target>
  <Target Name="RandoCodegen" BeforeTargets="ClCompile"
          DependsOnTargets="RandoCodegenState"
          Inputs="@(RandoCodegenInput);$(IntDir)rando_codegen_inputs.txt"
          Outputs="$(IntDir)rando_codegen.stamp">
    <Exec Command="python assets\rando_logic_gen.py" />
    <Touch Files="$(IntDir)rando_codegen.stamp" AlwaysCreate="true" />
  </Target>
  <Target Name="RandoAssetsHash" BeforeTargets="ClCompile">
    <Exec Condition="Exists('zelda3_assets.dat')" Command="python assets\scripts\check_assets_signature.py" />
    <Exec Condition="Exists('zelda3_assets.dat')" Command="python assets\scripts\dump_vanilla_assets_hash.py" />
    <Exec Condition="!Exists('zelda3_assets.dat') And !Exists('src\rando\vanilla_assets_hash.h')" Command="python assets\scripts\dump_vanilla_assets_hash.py --placeholder" />
  </Target>
  <Target Name="EnsureVendoredSdl2" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(Sdl2LibDir)SDL2.lib')" Text="Vendored SDL2 missing at $(Sdl2LibDir). Re-extract third_party/SDL2-2.32.10/ from libsdl.org's SDL2-devel-2.32.10-VC.zip." />
  </Target>
